# Copy to .env and fill in values
# .env is gitignored — never commit real secrets

SECRET_KEY=replace-with-a-real-secret-key-at-least-32-chars

# Admin registration key
REGISTRATION_SECRET_KEY=replace-with-a-strong-random-secret

DATABASE_URL=sqlite:///./db.sqlite3

# JWT lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Magic link auth
MAGIC_LINK_BASE_URL=http://localhost:5173
MAGIC_LINK_EXPIRY_MINUTES=15

# Email (set MAIL_CONSOLE=true in dev to print to stdout instead of sending)
MAIL_CONSOLE=true
MAIL_FROM=noreply@renovaite.com
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
